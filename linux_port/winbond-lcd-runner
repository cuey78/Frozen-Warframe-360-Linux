#!/bin/bash
#
# winbond-lcd-runner
# Keeps the Winbond USBDISPLAY (0416:5302) displaying an image continuously.
#
# Usage:
#   winbond-lcd-runner IMAGE_FILE [OPTIONS...]
#
# Options are passed through to usb_lcd_port.py (e.g. --fit cover --fps 20).
# The script waits for the device to appear at boot, then streams the image
# forever.  usb_lcd_port.py handles its own reconnection when the USB endpoint
# wedges, so this process just needs to stay alive.

set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LCD_PORT="$SCRIPT_DIR/usb_lcd_port.py"

IMAGE_FILE="${1:?Usage: winbond-lcd-runner IMAGE_FILE [OPTIONS...]}"
shift || true

# Wait for the device to become available (up to 60 seconds at boot).
for i in $(seq 1 60); do
    if python3 -c "import usb.core; exit(0 if usb.core.find(idVendor=0x0416, idProduct=0x5302) else 1)" 2>/dev/null; then
        break
    fi
    sleep 1
done

# Stream the image forever (no --duration = stream until killed).
# usb_lcd_port.py handles its own reconnection when the USB endpoint wedges.
exec python3 "$LCD_PORT" image "$IMAGE_FILE" --fps 20 "$@"
